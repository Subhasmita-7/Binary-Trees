Input: root = [1,2,2,3,4,4,3]
Output: true


/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean isSymmetric(TreeNode root) {
        if(root == null){
            return true;
        }
        return symmetry(root.left , root.right);
    }

    private boolean symmetry(TreeNode l , TreeNode r){
        if(l == null || r == null){
            return l == r;
        }

        return (l.val == r.val) && symmetry(l.left , r.right) && symmetry(l.right , r.left);
    }
}
