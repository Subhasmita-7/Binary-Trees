/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int widthOfBinaryTree(TreeNode root) {
        if(root == null){
            return 0;
        }

        int width = 0;
        Queue<Pair<TreeNode , Integer>> q = new LinkedList<>();

        q.offer(new Pair<>(root,0));

        while(!q.isEmpty()){
            int len = q.size();
            int index = q.peek().getValue();

            int start = 0;
            int end = 0;

            for(int i = 0 ; i<len ; i++){
                Pair<TreeNode , Integer> p = q.poll();
                TreeNode curr = p.getKey();
                int key = p.getValue() - index;

                if(i == 0){
                    start = key;
                }
                if(i == len -1){
                    end = key;
                }
                if(curr.left != null){
                    q.offer(new Pair<>(curr.left , 2*key));
                }
                if(curr.right != null){
                    q.offer(new Pair<>(curr.right , 2*key+1));
                }
            }

            width = Math.max(width , end - start +1);
        }
        return width;
    }
}
